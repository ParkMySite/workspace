:root {
  --navy: #10213b;
  --navy-2: #172d4d;
  --ink: #1d2a3b;
  --muted: #748196;
  --line: #e7ebf2;
  --bg: #f5f7fb;
  --blue: #3978f6;
  --blue-soft: #edf3ff;
  --green: #159a72;
  --green-soft: #e7f7f1;
  --violet: #7a62d3;
  --violet-soft: #f0edff;
  --orange: #d88435;
  --orange-soft: #fff3e6;
  --shadow: 0 18px 50px rgba(22, 42, 75, 0.08);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system,
    BlinkMacSystemFont, "Segoe UI", sans-serif;
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  color: var(--ink);
  background: var(--bg);
  font-size: 14px;
}
a {
  color: inherit;
  text-decoration: none;
}
button,
input {
  font: inherit;
}
.muted {
  color: var(--muted);
  line-height: 1.6;
}
.eyebrow {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.8px;
  color: #9eacc1;
  margin: 0 0 12px;
}
.accent {
  color: var(--blue);
}
h1,
h2,
h3,
p {
  margin-top: 0;
}
h1 {
  font-size: clamp(26px, 3vw, 34px);
  letter-spacing: -1.2px;
  margin-bottom: 8px;
}
h2 {
  font-size: 19px;
  letter-spacing: -0.4px;
  margin-bottom: 8px;
}
h3 {
  font-size: 15px;
  margin-bottom: 7px;
}
.brand-mark {
  height: 42px;
  width: 42px;
  border-radius: 13px;
  background: linear-gradient(145deg, #5b94ff, #2864df);
  display: grid;
  place-items: center;
  color: white;
  font-size: 21px;
  font-weight: 800;
  box-shadow: 0 8px 20px #2368e944;
}
.login-page {
  min-height: 100vh;
  background: white;
}
.login-shell {
  min-height: 100vh;
  display: grid;
  grid-template-columns: minmax(300px, 0.92fr) 1.08fr;
}
.login-brand {
  background: radial-gradient(ellipse at 10% 5%, #264b7a 0, transparent 42%),
    linear-gradient(145deg, #10213b, #0c1729);
  padding: clamp(35px, 7vw, 100px);
  color: white;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  position: relative;
  overflow: hidden;
}
.login-brand:after {
  content: "";
  position: absolute;
  width: 440px;
  height: 440px;
  border: 1px solid #ffffff12;
  border-radius: 50%;
  right: -170px;
  bottom: -150px;
  box-shadow: 0 0 0 45px #ffffff05, 0 0 0 90px #ffffff04;
}
.login-brand .eyebrow {
  margin-top: 42px;
}
.login-brand h1 {
  font-size: clamp(36px, 4.6vw, 58px);
  line-height: 1.12;
  letter-spacing: -2.4px;
  margin: 0 0 22px;
}
.login-brand h1 span {
  color: #82b1ff;
}
.brand-copy {
  color: #b4c2d6;
  max-width: 390px;
  line-height: 1.8;
  font-size: 15px;
}
.brand-bottom {
  margin-top: auto;
  padding-top: 65px;
  color: #b8c9dc;
  font-size: 12px;
  display: flex;
  align-items: center;
  gap: 9px;
}
.status-dot {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #29c58d;
  box-shadow: 0 0 0 4px #29c58d20;
}
.login-panel {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 36px;
}
.login-card {
  width: min(100%, 390px);
}
.login-card h2 {
  font-size: 27px;
  letter-spacing: -0.9px;
  margin-bottom: 9px;
}
.login-card > .muted {
  margin-bottom: 32px;
}
.login-card label {
  font-size: 12px;
  font-weight: 700;
  display: block;
  margin-bottom: 9px;
}
.login-card input {
  width: 100%;
  border: 1px solid #dce3ed;
  border-radius: 10px;
  padding: 14px 14px;
  background: #fff;
  outline: none;
  margin-bottom: 21px;
  transition: 0.2s;
}
.login-card input:focus {
  border-color: #6e9cff;
  box-shadow: 0 0 0 4px #3978f612;
}
.password-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.text-button {
  border: 0;
  background: none;
  color: var(--blue);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  margin-bottom: 9px;
}
.primary-button {
  border: 0;
  background: linear-gradient(110deg, #3978f6, #2864dc);
  color: white;
  border-radius: 10px;
  padding: 14px 18px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 8px 20px #3978f62b;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.primary-button:disabled {
  opacity: 0.65;
  cursor: wait;
}
.full-width {
  width: 100%;
}
.form-message {
  min-height: 18px;
  color: #c44545;
  font-size: 12px;
  margin: -7px 0 10px;
}
.login-help {
  font-size: 11px;
  color: #8b97a9;
  text-align: center;
  margin: 25px 0 0;
}
.login-footer {
  margin-top: 60px;
  color: #99a3b2;
  font-size: 11px;
  display: flex;
  gap: 8px;
  justify-content: center;
  flex-wrap: wrap;
}
.mobile-brand {
  display: none;
}
.app-layout {
  min-height: 100vh;
  display: flex;
}
.sidebar {
  width: 248px;
  background: var(--navy);
  color: #c0ccdc;
  display: flex;
  flex-direction: column;
  padding: 25px 16px 16px;
  flex-shrink: 0;
  min-height: 100vh;
}
.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 10px 30px;
  color: white;
  font-weight: 750;
  font-size: 14px;
}
.sidebar-brand .brand-mark {
  height: 36px;
  width: 36px;
  border-radius: 11px;
  font-size: 17px;
}
.brand-sub {
  display: block;
  color: #8296b1;
  font-size: 10px;
  font-weight: 500;
  margin-top: 4px;
}
.nav-caption {
  font-size: 9px;
  letter-spacing: 1.6px;
  color: #7589a5;
  font-weight: 800;
  padding: 8px 12px 12px;
}
.nav-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border-radius: 9px;
  color: #b9c7d9;
  font-size: 12px;
  margin-bottom: 4px;
  transition: 0.15s;
}
.nav-link:hover {
  background: #ffffff0b;
  color: white;
}
.nav-link.active {
  background: #3978f629;
  color: #fff;
  box-shadow: inset 3px 0 #6195ff;
}
.nav-icon {
  width: 18px;
  text-align: center;
  font-size: 16px;
}
.sidebar-spacer {
  flex: 1;
}
.sidebar-support {
  padding: 16px 13px;
  background: #ffffff09;
  border: 1px solid #ffffff12;
  border-radius: 12px;
  margin: 20px 2px;
}
.sidebar-support strong {
  display: block;
  font-size: 12px;
  color: #fff;
  margin-bottom: 6px;
}
.sidebar-support p {
  font-size: 10px;
  line-height: 1.6;
  color: #94a7c0;
  margin: 0;
}
.sidebar-bottom {
  padding: 18px 10px 0;
  color: #7086a2;
  font-size: 10px;
}
.app-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.topbar {
  height: 76px;
  background: #fff;
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 36px;
  gap: 20px;
}
.topbar-left {
  display: flex;
  align-items: center;
  gap: 13px;
}
.topbar-title {
  font-size: 13px;
  font-weight: 750;
}
.topbar-sub {
  font-size: 10px;
  color: #96a1b1;
  margin-top: 4px;
}
.topbar-right {
  display: flex;
  align-items: center;
  gap: 18px;
}
.search-pill {
  background: #f6f8fb;
  border: 1px solid #edf0f5;
  border-radius: 9px;
  padding: 10px 13px;
  color: #97a2b2;
  font-size: 11px;
  min-width: 180px;
}
.profile {
  display: flex;
  align-items: center;
  gap: 10px;
}
.avatar {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #e7efff;
  color: #316bdf;
  font-size: 12px;
  font-weight: 800;
}
.profile-name {
  font-size: 11px;
  font-weight: 750;
}
.profile-role {
  font-size: 10px;
  color: #8995a6;
  margin-top: 4px;
}
.icon-button {
  border: 0;
  background: none;
  color: #758196;
  font-size: 19px;
  cursor: pointer;
}
.page-content {
  padding: 32px 36px 38px;
  flex: 1;
  max-width: 1600px;
  width: 100%;
  margin: 0 auto;
}
.welcome-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 28px;
}
.welcome-row .muted {
  margin: 0;
}
.date-chip {
  border: 1px solid var(--line);
  background: #fff;
  border-radius: 9px;
  padding: 11px 13px;
  color: #65748a;
  font-size: 11px;
  white-space: nowrap;
}
.date-icon {
  font-size: 15px;
  margin-right: 8px;
}
.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 17px;
  margin-bottom: 34px;
}
.stat-card,
.content-card,
.module-card {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 13px;
  box-shadow: 0 4px 16px #203b6105;
}
.stat-card {
  padding: 20px 21px;
}
.stat-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 19px;
}
.stat-icon,
.module-icon {
  width: 38px;
  height: 38px;
  border-radius: 11px;
  display: grid;
  place-items: center;
  font-size: 18px;
  font-weight: 700;
}
.blue {
  background: var(--blue-soft);
  color: var(--blue);
}
.green {
  background: var(--green-soft);
  color: var(--green);
}
.violet {
  background: var(--violet-soft);
  color: var(--violet);
}
.orange {
  background: var(--orange-soft);
  color: var(--orange);
}
.stat-trend {
  font-size: 10px;
  color: #8390a3;
  background: #f7f9fc;
  border-radius: 20px;
  padding: 6px 9px;
}
.stat-label {
  font-size: 11px;
  color: #7c899b;
  margin-bottom: 8px;
}
.stat-card h2 {
  font-size: 26px;
  margin-bottom: 9px;
  letter-spacing: -0.8px;
}
.stat-card h2.role-value {
  font-size: 22px;
}
.stat-foot {
  font-size: 10px;
  color: #8996a8;
  margin: 0;
  display: flex;
  align-items: center;
  gap: 7px;
}
.stat-foot .status-dot {
  width: 6px;
  height: 6px;
  box-shadow: none;
}
.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}
.section-heading h2 {
  margin: 0 0 5px;
}
.section-heading p {
  margin: 0;
  font-size: 11px;
}
.section-kicker {
  font-size: 9px;
  letter-spacing: 1.4px;
  color: #9aa5b5;
  font-weight: 800;
}
.module-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 30px;
}
.module-card {
  padding: 18px;
  min-height: 158px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  position: relative;
}
.module-card:hover {
  transform: translateY(-3px);
  border-color: #cbd9f6;
  box-shadow: var(--shadow);
}
.module-icon {
  margin-bottom: 17px;
}
.module-card h3 {
  font-size: 13px;
}
.module-card p {
  font-size: 10px;
  line-height: 1.6;
  color: #8490a2;
  margin: 0;
  max-width: 200px;
}
.module-arrow {
  position: absolute;
  right: 16px;
  top: 17px;
  color: #9eabc0;
  font-size: 15px;
}
.bottom-grid {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  gap: 17px;
}
.content-card {
  padding: 22px;
}
.card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 18px;
}
.card-heading h2 {
  font-size: 15px;
  margin-bottom: 5px;
}
.card-heading p {
  font-size: 10px;
  margin: 0;
}
.live-pill {
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1px;
  color: #8996a8;
  background: #f5f7fb;
  border-radius: 6px;
  padding: 6px 8px;
}
.activity-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 0;
  border-top: 1px solid #f0f2f6;
}
.activity-symbol {
  width: 30px;
  height: 30px;
  border-radius: 9px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}
.activity-row strong {
  font-size: 11px;
}
.activity-row p {
  font-size: 10px;
  color: #8b97a8;
  margin: 4px 0 0;
}
.activity-row time {
  margin-left: auto;
  color: #9ba6b5;
  font-size: 9px;
  white-space: nowrap;
}
.status-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  padding: 14px 0;
  border-bottom: 1px solid #f0f2f6;
  font-size: 11px;
  color: #7e8b9e;
}
.status-value {
  font-weight: 700;
  color: #526176;
  display: flex;
  align-items: center;
  gap: 7px;
}
.mini-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  display: inline-block;
}
.green-dot {
  background: #19b986;
}
.amber-dot {
  background: #efa43a;
}
.notice {
  display: flex;
  gap: 10px;
  background: #f5f8ff;
  color: #5275b5;
  padding: 12px;
  border-radius: 9px;
  margin-top: 18px;
  font-size: 12px;
}
.notice p {
  font-size: 10px;
  line-height: 1.6;
  margin: 0;
  color: #6c7f9f;
}
.app-footer {
  padding: 18px 36px;
  border-top: 1px solid var(--line);
  background: #fff;
  color: #9aa4b2;
  font-size: 10px;
  display: flex;
  justify-content: space-between;
  gap: 10px;
}
.app-footer strong {
  color: #65748a;
  font-weight: 650;
}
.placeholder-card {
  margin-top: 22px;
  max-width: 720px;
  padding: 30px;
}
.placeholder-card p {
  color: #7d899b;
  line-height: 1.7;
}
.menu-toggle {
  display: none;
}
@media (max-width: 1100px) {
  .sidebar {
    width: 218px;
  }
  .page-content {
    padding: 28px 24px;
  }
  .topbar {
    padding: 0 24px;
  }
  .module-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .bottom-grid {
    grid-template-columns: 1fr;
  }
  .search-pill {
    display: none;
  }
}
@media (max-width: 760px) {
  .login-shell {
    grid-template-columns: 1fr;
  }
  .login-brand {
    display: none;
  }
  .login-panel {
    min-height: 100vh;
    padding: 24px;
  }
  .mobile-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 750;
    margin-bottom: auto;
    width: min(100%, 390px);
    padding-top: 10px;
  }
  .mobile-brand .brand-mark {
    width: 34px;
    height: 34px;
    font-size: 17px;
  }
  .login-card {
    margin: auto 0;
    padding: 42px 0;
  }
  .login-footer {
    margin-top: auto;
    padding-bottom: 10px;
  }
  .sidebar {
    position: fixed;
    z-index: 20;
    left: -260px;
    top: 0;
    bottom: 0;
    transition: left 0.22s;
    box-shadow: var(--shadow);
  }
  .sidebar.open {
    left: 0;
  }
  .app-main {
    width: 100%;
  }
  .topbar {
    height: 66px;
    padding: 0 17px;
  }
  .menu-toggle {
    display: inline-block;
  }
  .topbar-sub {
    display: none;
  }
  .topbar-right {
    gap: 10px;
  }
  .profile-name,
  .profile-role {
    display: none;
  }
  .page-content {
    padding: 25px 17px;
  }
  .welcome-row {
    align-items: flex-start;
    flex-direction: column;
  }
  .date-chip {
    align-self: flex-start;
  }
  .stat-grid {
    grid-template-columns: 1fr;
    gap: 11px;
  }
  .stat-card {
    padding: 17px;
  }
  .stat-top {
    margin-bottom: 13px;
  }
  .module-grid {
    gap: 10px;
  }
  .module-card {
    padding: 14px;
    min-height: 155px;
  }
  .bottom-grid {
    gap: 12px;
  }
  .content-card {
    padding: 17px;
  }
  .activity-row time {
    display: none;
  }
  .app-footer {
    padding: 16px 17px;
    flex-direction: column;
  }
  .section-kicker {
    display: none;
  }
}
@media (max-width: 380px) {
  .module-grid {
    grid-template-columns: 1fr;
  }
  .module-card {
    min-height: 130px;
  }
  .topbar-title {
    font-size: 12px;
  }
}
